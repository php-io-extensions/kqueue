{
    "name": "php-io-extensions/kqueue",
    "type": "php-ext",
    "description": "1:1 PHP bindings of kqueue(2): kqueue(), kevent(), kevent64(), EV_SET(), EV_SET64()",
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "kqueue",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-kqueue",
                "description": "Enable the kqueue extension",
                "needs-value": false
            }
        ]
    }
}
